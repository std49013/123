            )
        ]


class WorkloadAllocator:
    """อัลกอริทึมจัดสรรงานอัตโนมัติโดยใช้ Skill Matching Score & Time Availability"""

    def __init__(self, team_members: List[TeamMember]):
        self.team = {m.member_id: m for m in team_members}

    def _calculate_match_score(self, task: MicroTask, member: TeamMember) -> float:
        """คำนวณคะแนนความเหมาะสม (0.0 - 1.0)"""
        if not task.required_skills:
            skill_score = 0.5
        else:
            # คำนวณอัตราส่วนทักษะที่ตรงกัน (Skill Match Ratio)
            matched_skills = set(task.required_skills).intersection(set(member.skills))
            skill_score = len(matched_skills) / len(task.required_skills)

        # คำนวณภาระงานและเวลาคงเหลือ (Availability Score)
        remaining_hours = member.available_hours - member.assigned_hours
        if remaining_hours < task.estimated_hours:
            availability_score = 0.0 # เวลาไม่พอ
        else:
            availability_score = remaining_hours / member.available_hours

        # ถ่วงน้ำหนักคะแนน: ทักษะ 70%, เวลาคงเหลือ 30%
        final_score = (skill_score * 0.7) + (availability_score * 0.3)
        return final_score

    def allocate_tasks(self, tasks: List[MicroTask]) -> List[TaskAssignment]:
        assignments = []

        # เรียงลำดับงานตามความสำคัญ (High -> Medium -> Low)
        priority_weight = {"High": 3, "Medium": 2, "Low": 1}
        sorted_tasks = sorted(tasks, key=lambda t: priority_weight.get(t.priority, 0), reverse=True)

        for task in sorted_tasks:
            best_candidate = None
            highest_score = -1.0

            for member_id, member in self.team.items():
                score = self._calculate_match_score(task, member)
                if score > highest_score and score > 0: # ต้องมีคะแนนมากกว่า 0 (ต้องมีเวลาพอ)
                    highest_score = score
                    best_candidate = member

            if best_candidate and highest_score > 0.2: # Threshold ขั้นต่ำ
                best_candidate.assigned_hours += task.estimated_hours
                assignments.append(
                    TaskAssignment(
                        task_id=task.id,
                        task_title=task.title,
                        assigned_to=best_candidate.name,
                        match_score=round(highest_score, 2),
                        reason=f"ทักษะสอดคล้องและมีเวลาพอ (รับงานแล้วรวม {best_candidate.assigned_hours}/{best_candidate.available_hours} ชม.)"
                    )
                )
            else:
                assignments.append(
                    TaskAssignment(
                        task_id=task.id,
                        task_title=task.title,
                        assigned_to=None,
                        match_score=0.0,
                        reason="ไม่มีสมาชิกที่มีทักษะตรง หรือเวลาคงเหลือไม่เพียงพอ"
                    )
                )

        return assignments


