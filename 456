import os
import json
from typing import List, Dict, Optional
from pydantic import BaseModel, Field

# หมายเหตุ: จำเป็นต้องเปิดใช้งาน openai package (pip install openai pydantic)
try:
    from openai import OpenAI
except ImportError:
    OpenAI = None


# ==========================================
# Data Models
# ==========================================

class MicroTask(BaseModel):
    id: str = Field(description="รหัสงานย่อย เช่น TASK-01")
    title: str = Field(description="หัวข้อของงานย่อย")
    description: str = Field(description="รายละเอียดสิ่งที่ต้องทำ")
    required_skills: List[str] = Field(description="ทักษะที่จำเป็นในการทำสคริปต์/งานนี้")
    estimated_hours: float = Field(description="เวลาที่คาดว่าจะใช้ (ชั่วโมง)")
    priority: str = Field(description="ความสำคัญ: High, Medium, Low")

class ProjectBreakdown(BaseModel):
    project_name: str
    tasks: List[MicroTask]

class TeamMember(BaseModel):
    member_id: str
    name: str
    skills: List[str]
    available_hours: float
    assigned_hours: float = 0.0

class TaskAssignment(BaseModel):
    task_id: str
    task_title: str
    assigned_to: Optional[str]
    match_score: float
    reason: str


# ==========================================
# Core Engine Classes
# ==========================================

class TaskDecomposer:
    """ใช้ LLM ย่อยโปรเจกต์ขนาดใหญ่ให้เป็น Micro-tasks"""
    
    def __init__(self, api_key: Optional[str] = None):
        self.api_key = api_key or os.getenv("OPENAI_API_KEY")
        if OpenAI and self.api_key:
            self.client = OpenAI(api_key=self.api_key)
        else:
            self.client = None

    def decompose(self, project_name: str, project_description: str) -> List[MicroTask]:
        """ย่อยโปรเจกต์โดยคืนค่าเป็น List ของ MicroTask"""
        if not self.client:
            print("[Warning] API Key ไม่พบ/ไม่ได้ติดตั้ง openai module -> ใช้งาน Mock Mode")
            return self._mock_decompose()

        prompt = f"""
        คุณคือ AI Project Manager ผู้เชี่ยวชาญในการทำ Task Breakdown Structure (TBS)
        โปรดทำการย่อยโปรเจกต์ต่อไปนี้ให้เป็นงานย่อย (Micro-tasks) ที่มีขอบเขตชัดเจน สามารถทำเสร็จได้ในระยะเวลา short-term (1-8 ชั่วโมงต่อ task):

        ชื่อโปรเจกต์: {project_name}
        รายละเอียด: {project_description}
        """

        try:
            response = self.client.beta.chat.completions.parse(
                model="gpt-4o-mini",
                messages=[
                    {"role": "system", "content": "คุณคือระบบวางแผนงานอัตโนมัติ ตอบกลับเฉพาะรูปแบบ JSON Schema ที่กำหนดเท่านั้น"},
                    {"role": "user", "content": prompt}
                ],
                response_format=ProjectBreakdown
            )
            parsed_data: ProjectBreakdown = response.choices[0].message.parsed
            return parsed_data.tasks
        except Exception as e:
            print(f"[Error] การสื่อสารกับ LLM ล้มเหลว: {e}")
            return self._mock_decompose()

    def _mock_decompose(self) -> List[MicroTask]:
        """ตัวอย่างข้อมูลจำลองกรณีไม่ได้เชื่อมต่อ API"""
        return [
            MicroTask(
                id="TASK-01",
                title="ออกแบบ DB Schema สำหรับระบบสมาชิก",
                description="ออกแบบ ER-Diagram และเขียนไฟล์ Migration script",
                required_skills=["Database", "SQL", "Backend"],
                estimated_hours=4.0,
                priority="High"
            ),
            MicroTask(
                id="TASK-02",
                title="พัฒนา REST API Authentication (JWT)",
                description="เขียน Login/Register endpoint พร้อม Middleware ตรวจสอบ Token",
                required_skills=["Python", "FastAPI", "Backend", "Security"],
                estimated_hours=6.0,
                priority="High"
            ),
            MicroTask(
                id="TASK-03",
                title="ออกแบบ UI Landing Page",
                description="สร้าง Wireframe และ Design Token ใน Figma",
                required_skills=["UI/UX", "Figma", "Frontend Design"],
                estimated_hours=5.0,
                priority="Medium"
            ),
            MicroTask(
                id="TASK-04",
                title="เขียน Frontend Component หน้า Login",
                description="พัฒนา React Component ตามดีไซน์ Figma",
                required_skills=["React", "Frontend", "TypeScript"],
